  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSistem
  playerSelectionData: {fileID: 11400000, guid: ad9a01878997d7a41840fead73e5b0e2, type: 2}
  playerStatsList:
  - {fileID: 11400000, guid: 45bc7567054e03344b1d2ef8296eea8b, type: 2}
  - {fileID: 11400000, guid: 33f326517483cac41a16d8432fd71429, type: 2}
  - {fileID: 11400000, guid: c1b40d85d72f41141b244857cff73032, type: 2}
  iconImage: {fileID: 230436874}
  nameText: {fileID: 90989042}
  dialogueText: {fileID: 356906821}
  dialogueDuration: 2.5
  dialogueSequences:
  - combinationKey: Pasillo_1_0_1_2
    lines:
    - characterIndex: 2
      text: Veo veo...
    - characterIndex: 1
      text: ...
    - characterIndex: 0
      text: "*Suspira* \xBFQu\xE9 ves?"
    - characterIndex: 2
      text: Una cosita.
    - characterIndex: 1
      text: "\xBFVas en serio Raven?"
    - characterIndex: 0
      text: "Es m\xE1s divertido que escucharte a t\xED. \xBFQu\xE9 cosita es?"
    - characterIndex: 2
      text: "\xA1Una bomba!"
    - characterIndex: 0
      text: "Se supone que ten\xEDas que decirme la let- \xBFEso es una bomba?"
    - characterIndex: 1
      text: "\xA1\xBF?!"
    - characterIndex: 2
      text: "Ah no, es solo una bater\xEDa"
    - characterIndex: 1
      text: ...
    - characterIndex: 0
      text: ...
    - characterIndex: 1
      text: "Cuando esta mierda se pare voy a usarte a t\xED de se\xF1al de tr\xE1fico."
  - combinationKey: Pasillo_1_0_2
    lines:
    - characterIndex: 2
      text: Veo veo...
    - characterIndex: 0
      text: "\xBFOtra vez...?"
    - characterIndex: 0
      text: "Agh vale,\xBFqu\xE9 ves?"
    - characterIndex: 2
      text: Una cosita.
    - characterIndex: 1
      text: "\xBFY qu\xE9 cosita es?"
    - characterIndex: 2
      text: "Empieza por la letrita... \xA1B!"
    - characterIndex: 0
      text: "Guau, d\xE9jame adivinar, \xBFuna bomba?"
    - characterIndex: 2
      text: "\xBFC\xF3mo lo has sabido?"
    - characterIndex: 0
      text: "Es la \xFAnica cosa que has dicho cada vez que hemos jugado a esto."
    - characterIndex: 2
      text: "Ya veo, y pensaba que esta era la buena porque es peque\xF1ita..."
    - characterIndex: 0
      text: "\xBFC\xF3mo que es peque\xF1ita?"
    - characterIndex: 2
      text: "No te preocupes, ya le hemos pasado por encima, suerte que no se activ\xF3..."
    - characterIndex: 0
      text: ...
  - combinationKey: Pasillo_1_0_1
    lines:
    - characterIndex: 1
      text: "(Ah\xED viene de nuevo...)"
    - characterIndex: 2
      text: Veo veo...
    - characterIndex: 1
      text: "Ten los cojones met\xE1licos de decir bomba Eugene..."
    - characterIndex: 2
      text: ...
    - characterIndex: 1
      text: "Eso cre\xEDa..."
    - characterIndex: 2
      text: "\xBFSabes Zofy? Creo que te vendr\xEDa bien tomarte algo."
    - characterIndex: 1
      text: "Y a t\xED te vendr\xEDa bien tomar menos, puto pirado..."
    - characterIndex: 2
      text: Yo solo bebo agua y diesel.
    - characterIndex: 1
      text: ...
    - characterIndex: 2
      text: Especialmente diesel.
    - characterIndex: 1
      text: Eso...
    - characterIndex: 2
      text: "\xBFMhm?"
    - characterIndex: 1
      text: Eso explica muchas cosas.
